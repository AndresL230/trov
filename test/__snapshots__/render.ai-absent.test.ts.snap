      <div style="display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;margin-top:8px"><span class="plat-tile-n" style="font-family:var(--label);font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap;font-size:27px;letter-spacing:-0.02em">4</span><span style="font-size:11px;color:var(--fg-40)">with an account</span></div>
      

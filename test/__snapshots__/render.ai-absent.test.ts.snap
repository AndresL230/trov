      <span class="cnpy-sk" style="width:96px;height:9px;margin-top:6px"></span>
    </div></div></div></section><section class="cnpy-surface mw-tile cnpy-rise" style="min-width:0;display:flex;flex-direction:column;overflow:hidden;--span:6" data-mw="sessions" data-screen-label="My Work · Your sessions"><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px 0">
    <span style="display:inline-flex;align-items:baseline;gap:8px;min-width:0;white-space:nowrap"><span style="font-size:14px;font-weight:500">Your sessions</span></span><button data-act="goFeed" class="mw-more" style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;color:var(--fg-40);white-space:nowrap;padding:0">Feed<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
  </div><div style="height:12px"></div><div class="mw-scroll" style="display:flex;flex-direction:column"><div class="cnpy-skel" data-skel="mw-sessions" aria-busy="true"><span class="cnpy-sr" role="status">Loading&hellip;</span><div class="cnpy-skel-in" aria-hidden="true"><div style="display:flex;align-items:flex-start;gap:12px;padding:10px 16px;border-top:1px solid var(--border)">
      
      <span class="cnpy-skcol"><span class="cnpy-skl" style="height:20px"><span class="cnpy-sk" style="width:72%;height:10px"></span></span><span style="display:block;margin-top:3px"><span class="cnpy-skl" style="height:19px"><span class="cnpy-sk" style="width:34%;height:9px"></span></span></span></span>
      <span class="cnpy-sk" style="width:40px;height:9px;margin-top:6px"></span>

    </div></div></div></div></section><section class="cnpy-surface mw-tile cnpy-rise" style="min-width:0;display:flex;flex-direction:column;overflow:hidden;--span:6" data-mw="repo" data-screen-label="My Work · Repo monitor"><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px 0">
    <span style="display:inline-flex;align-items:baseline;gap:8px;min-width:0;white-space:nowrap"><span style="font-size:14px;font-weight:500">Repo</span></span><button data-act="goRepo" class="mw-more" style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;color:var(--fg-40);white-space:nowrap;padding:0">Dashboard<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>

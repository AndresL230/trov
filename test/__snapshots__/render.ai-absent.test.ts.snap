        <span>·</span><span style="white-space:nowrap">Sprint 13</span>
        
      </span>
    </span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fg-40)" stroke-width="1.8" style="flex:none;margin-top:4px"><path d="M9 6l6 6-6 6"></path></svg>
  </button><button data-act="openTicket" data-arg="14" class="mw-row" style="display:flex;align-items:flex-start;gap:12px;width:100%;text-align:left;padding:10px 16px;border-top:1px solid var(--border)">
    <span style="font-family:var(--label);font-size:12px;font-weight:600;color:var(--fg-55);flex:none;margin-top:2px;width:44px">Normal</span>
    <span style="flex:1;min-width:0;display:block">
      <span style="display:block;font-size:14px;font-weight:500;color:var(--fg);line-height:1.4;text-wrap:pretty">Guided repository setup</span>
      <span style="display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-top:3px;font-size:12.5px;color:var(--fg-40)">
        <span style="display:inline-flex;align-items:center;gap:5px;white-space:nowrap"><svg width="12" height="12" viewBox="0 0 14 14" fill="none" style="flex:none;display:block;color:var(--fg-55)" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.4 1.9"/></svg>Triage</span>
        <span>·</span><span style="white-space:nowrap">Sprint 13</span>
        
      </span>
    </span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--fg-40)" stroke-width="1.8" style="flex:none;margin-top:4px"><path d="M9 6l6 6-6 6"></path></svg>
  </button></div></section><section class="cnpy-surface mw-tile cnpy-rise" style="min-width:0;display:flex;flex-direction:column;overflow:hidden;--span:5" data-mw="review" data-screen-label="My Work · Needs your review"><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px 0">
    <span style="display:inline-flex;align-items:baseline;gap:8px;min-width:0;white-space:nowrap"><span style="font-size:14px;font-weight:500"><span style="display:inline-flex;align-items:center;gap:7px"><span style="width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none"></span>Needs your review</span></span></span><button data-act="goReview" class="mw-more" style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;color:var(--fg-40);white-space:nowrap;padding:0">View all<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
  </div><div class="cnpy-skel" data-skel="mw-review" aria-busy="true" style="padding-top:12px"><span class="cnpy-sr" role="status">Loading&hellip;</span><div class="cnpy-skel-in" aria-hidden="true"><div style="display:flex;align-items:flex-start;gap:12px;padding:10px 16px;border-top:1px solid var(--border)">
      
      <span class="cnpy-skcol"><span class="cnpy-skl" style="height:20px"><span class="cnpy-sk" style="width:72%;height:10px"></span></span><span style="display:block;margin-top:3px"><span class="cnpy-skl" style="height:19px"><span class="cnpy-sk" style="width:34%;height:9px"></span></span></span></span>

`;

exports[`field absent — each screen renders exactly what it did before the AI kit > Feed, both views (no entry carries \`ai\`) > reading 1`] = `
"<div data-cnpy-theme="light" data-screen="feed" data-collapsed="0" data-narrow="0" data-phone="0" data-drawer="0" data-author="all" style="background:var(--bg);color:var(--fg);min-height:100vh;font-family:'Geist','Geist Fallback',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased">

      <div data-sync-slot="ctl" class="sync-slot"></div><span data-mtip="staging: Degraded. Checks are failing on the branch head." style="display:inline-flex;align-items:center;gap:7px;font-size:12px;white-space:nowrap;color:var(--fg-70)"><span class="repo-envdot repo-pulse" style="--c:var(--amber);width:7px;height:7px;border-radius:50%;background:var(--amber);box-shadow:0 0 0 3px color-mix(in srgb,var(--amber) 16%,transparent)"></span>staging</span><span data-mtip="production: Failing. A deploy part failed." style="display:inline-flex;align-items:center;gap:7px;font-size:12px;white-space:nowrap;color:var(--fg-70)"><span class="repo-envdot repo-pulse" style="--c:var(--red);width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 0 3px color-mix(in srgb,var(--red) 16%,transparent)"></span>production</span><div style="width:1px;height:20px;background:var(--border);margin:0 2px"></div>
    <span data-repo-updated style="font-size:11.5px;color:var(--fg-40);white-space:nowrap">updated just now</span><button data-act="repoPollNow" title="Poll deploys, CI, usage and health now (admin) — issues refresh with Sync GitHub" aria-label="Poll deploys, CI, usage and health now (admin) — issues refresh with Sync GitHub" class="cnpy-outlinebtn repo-pollbtn" style="height:32px;padding:0 12px;border-radius:8px;border:1px solid var(--border);display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:500;white-space:nowrap;color:var(--fg-55);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg><span class="repo-pollbtn-label">Poll now</span>
    </button>
    <button data-act="repoRefresh" title="Reload from Trov's database" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path><path d="M21 3v5h-5"></path></svg>
    </button><button data-act="supportOpen" data-arg="bug" data-support-trigger="bug" title="Report a bug" aria-label="Report a bug" aria-haspopup="dialog" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">

      <div class="plat-c" style="min-width:0"><span class="plat-cl">Active</span><span style="font-variant-numeric:tabular-nums;font-size:12.5px;font-weight:400;white-space:nowrap;color:var(--fg-55)">3</span></div>
      <div class="plat-c" style="min-width:0"><span class="plat-cl">Members</span><span style="font-variant-numeric:tabular-nums;font-size:12.5px;font-weight:400;white-space:nowrap;color:var(--fg-55)">4</span></div>

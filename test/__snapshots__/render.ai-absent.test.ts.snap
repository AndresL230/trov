    </nav>
    <div class="cnpy-collapse" data-tip="Expand sidebar">
      <button data-act="toggleCollapse" class="cnpy-nav-i" aria-label="Collapse sidebar" aria-expanded="true"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path><path d="M14.5 9.5 12 12l2.5 2.5"></path></svg><span class="cnpy-lbl cnpy-nav-t">Collapse</span></button>
    </div>
    <div class="cnpy-ghost cnpy-lbl">agents produce · humans confirm</div>
    <div class="cnpy-foot" data-tip="Settings">
      <button data-act="goSettings" aria-label="Settings" class="cnpy-chip">
        <div class="cnpy-av" title="Alice" style="--c:var(--p-moss);position:relative;width:28px;height:28px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:10px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AL</div>
        <div class="cnpy-lbl cnpy-chip-t"><div class="cnpy-chip-n">alice</div><div class="cnpy-chip-h"><span style="font-family:var(--sans);font-size:11px;font-weight:500;color:var(--p-moss)">@alice</span></div></div>
        <svg class="cnpy-lbl" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" style="flex:none" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </button>
    </div>
    <div class="cnpy-tip" role="tooltip" data-keep></div>
  </aside>
    <main style="flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bg)">
      <header class="cnpy-hdr" style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 var(--hdr-pr, 24px) 0 var(--hdr-pl, 24px);min-height:57px;border-bottom:1px solid var(--border);flex:none">
    <div class="cnpy-hdr-l" style="display:flex;align-items:center;gap:12px;min-width:0">
      <button data-act="openDrawer" class="cnpy-menubtn cnpy-iconbtn" aria-label="Open navigation" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button><h1 style="font-size:15px;font-weight:600;letter-spacing:-0.01em;margin:0">Feed</h1>
      
    </div>
    <div class="cnpy-hdr-r" style="display:flex;align-items:center;gap:8px;flex:none">
      <div style="position:relative;display:flex;align-items:stretch;height:32px"><div data-hover-menu="feed" style="display:flex"><button data-act="fmToggle" data-arg="feed" aria-haspopup="dialog" aria-expanded="false" class="cnpy-ghostbtn fm-btn" style="display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:500;border-radius:7px;border:1px solid var(--border-strong);height:100%;padding:0 11px 0 12px;white-space:nowrap;color:var(--fg-70)">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16"></path><path d="M7 12h10"></path><path d="M10 18h4"></path></svg>Filter
    
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true" style="opacity:.7"><path d="m6 9 6 6 6-6"></path></svg>
  </button></div></div><div data-sync-slot="ctl" class="sync-slot"></div><div class="cnpy-seg cnpy-seg--md" data-seg="feed-view" data-morph-key="seg:feed-view" role="group" aria-label="Feed view"><span class="cnpy-seg-ind" aria-hidden="true" data-keep></span><button type="button" tabindex="0" data-field="seg:feed-view:reading" class="cnpy-seg-btn is-on" aria-pressed="true">For reading</button><button type="button" tabindex="-1" data-field="seg:feed-view:agents" class="cnpy-seg-btn" data-act="setFeedView" data-arg="agents" aria-pressed="false">For agents</button></div><button data-act="supportOpen" data-arg="bug" data-support-trigger="bug" title="Report a bug" aria-label="Report a bug" aria-haspopup="dialog" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="7" width="8" height="12" rx="4"></rect><path d="M12 12v7"></path><path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path><path d="M4 13h4M16 13h4M5 7l3.2 2.6M19 7l-3.2 2.6M5 20l3.2-2.8M19 20l-3.2-2.8"></path></svg>
    </button><button data-act="cycleTheme" title="Toggle theme" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path></svg>
    </button>
    </div>
  </header>
      <div id="cnpy-main" tabindex="-1" class="cnpy-scroll" style="flex:1;overflow-y:auto;min-height:0"><div class="cnpy-scroll cnpy-cols-page cnpy-feed-page" style="max-width:var(--frame-feed);margin:0 auto;padding:var(--cols-pad-top) 32px 80px">
    <div class="cnpy-cols">
      <div style="min-width:0"><div class="cnpy-stagger"><div class="cnpy-surface cnpy-card" style="padding:16px 18px;margin-bottom:12px">
      <div style="display:flex;align-items:flex-start;gap:12px">
        <div style="margin-top:1px"><button data-act="openPerson" data-arg="andres" class="cnpy-personav" title="Andres" aria-label="Andres — person card" style="display:flex;flex:none;padding:0;border-radius:50%"><div class="cnpy-av" title="Andres" style="--c:var(--p-sky);position:relative;width:30px;height:30px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:11px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AN</div></button></div>
        <div style="flex:1;min-width:0">
          <div class="cnpy-md-inline" style="font-size:14px;font-weight:500;line-height:1.5;letter-spacing:-0.005em">Decision: hosting connections stay read-only</div>
          <div class="cnpy-feed-brief" style="font-size:13.5px;color:var(--fg-70);line-height:1.6;margin-top:5px">Trov reads deployments but never changes anything there.</div>
          <div style="display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:12px">
            <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--fg-55)"><button data-act="openPerson" data-arg="andres" class="cnpy-personlink" title="Andres" style="padding:0"><span style="font-family:var(--sans);font-size:12px;font-weight:500;color:var(--p-sky)">@andres</span></button></div>
            <span data-mtip="Written by an agent session, recorded as this person." style="display:inline-flex;align-items:center;gap:4px;font-size:12px;color:var(--fg-55);white-space:nowrap"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" style="flex:none;display:block;color:currentColor" aria-hidden="true"><rect x="4" y="8" width="16" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M12 8V4M8.5 13h.01M15.5 13h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>agent</span>
            <span style="font-size:12px;color:var(--fg-40)">&middot;</span>
            <span style="font-size:12px;color:var(--fg-40)">3h ago</span>
            
            <div style="flex:1"></div>
          </div>
          <div style="display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-top:11px;padding-top:11px;border-top:1px solid var(--border)">
          <a href="" target="_blank" class="cnpy-issuechip" style="display:inline-flex;align-items:center;gap:6px;font-size:11.5px;border:1px solid var(--border);border-radius:6px;padding:3px 8px;text-decoration:none;color:var(--fg-70)"><span style="color:var(--fg-40)">PR</span><span style="font-family:var(--label);font-weight:500">#173</span></a><a href="" target="_blank" class="cnpy-issuechip" style="display:inline-flex;align-items:center;gap:6px;font-size:11.5px;border:1px solid var(--border);border-radius:6px;padding:3px 8px;text-decoration:none;color:var(--fg-70)"><span style="color:var(--fg-40)">commit</span><span style="font-family:var(--label);font-weight:500">65b9f1f</span></a>
        </div>
        </div>
      </div>
    </div><div class="cnpy-surface cnpy-card" style="padding:16px 18px;margin-bottom:12px">
      <div style="display:flex;align-items:flex-start;gap:12px">
        <div style="margin-top:1px"><button data-act="openPerson" data-arg="alice" class="cnpy-personav" title="Alice" aria-label="Alice — person card" style="display:flex;flex:none;padding:0;border-radius:50%"><div class="cnpy-av" title="Alice" style="--c:var(--p-moss);position:relative;width:30px;height:30px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:11px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AL</div></button></div>
        <div style="flex:1;min-width:0">
          <div class="cnpy-md-inline" style="font-size:14px;font-weight:500;line-height:1.5;letter-spacing:-0.005em">Shipped the colored-handle change</div>
          
          <div style="display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:12px">
            <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--fg-55)"><button data-act="openPerson" data-arg="alice" class="cnpy-personlink" title="Alice" style="padding:0"><span style="font-family:var(--sans);font-size:12px;font-weight:500;color:var(--p-moss)">@alice</span></button></div>
            <span data-mtip="Written by an agent session, recorded as this person." style="display:inline-flex;align-items:center;gap:4px;font-size:12px;color:var(--fg-55);white-space:nowrap"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" style="flex:none;display:block;color:currentColor" aria-hidden="true"><rect x="4" y="8" width="16" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M12 8V4M8.5 13h.01M15.5 13h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>agent</span>
            <span style="font-size:12px;color:var(--fg-40)">&middot;</span>
            <span style="font-size:12px;color:var(--fg-40)">1d ago</span>
            
            <div style="flex:1"></div>
          </div>
          
        </div>
      </div>
    </div></div>
    <div style="text-align:center;padding:18px 0;font-size:11.5px;color:var(--fg-40);font-family:var(--label)">&mdash; start of recorded history &mdash;</div></div>
      <aside class="cnpy-cols-aside cnpy-stagger"><section class="cnpy-surface cnpy-rise" style="min-width:0;overflow:hidden" data-screen-label="Feed · This week"><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px 8px"><span style="font-size:14px;font-weight:500">This week</span><button data-act="setRange" data-arg="7d" class="mw-more" style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;color:var(--fg-40);white-space:nowrap;padding:0">Everything this week<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button></div><div style="font-size:12.5px;color:var(--fg-40);padding:0 18px 10px;margin-top:-4px">Whole team, last 7 days</div><div class="cnpy-skel" data-skel="feed-week" aria-busy="true"><span class="cnpy-sr" role="status">Loading&hellip;</span><div class="cnpy-skel-in" aria-hidden="true"><div style="display:flex;align-items:center;gap:8px;padding:0 18px 12px"><span class="cnpy-sk" style="width:34px;height:24px"></span><span class="cnpy-sk" style="width:120px;height:9px"></span></div>
      <div style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;padding:0 18px 14px"><span style="display:flex;flex-direction:column;align-items:center;gap:5px"><span class="cnpy-sk" style="width:100%;height:36px"></span><span class="cnpy-sk" style="width:8px;height:10px"></span></span><span style="display:flex;flex-direction:column;align-items:center;gap:5px"><span class="cnpy-sk" style="width:100%;height:36px"></span><span class="cnpy-sk" style="width:8px;height:10px"></span></span><span style="display:flex;flex-direction:column;align-items:center;gap:5px"><span class="cnpy-sk" style="width:100%;height:36px"></span><span class="cnpy-sk" style="width:8px;height:10px"></span></span><span style="display:flex;flex-direction:column;align-items:center;gap:5px"><span class="cnpy-sk" style="width:100%;height:36px"></span><span class="cnpy-sk" style="width:8px;height:10px"></span></span><span style="display:flex;flex-direction:column;align-items:center;gap:5px"><span class="cnpy-sk" style="width:100%;height:36px"></span><span class="cnpy-sk" style="width:8px;height:10px"></span></span><span style="display:flex;flex-direction:column;align-items:center;gap:5px"><span class="cnpy-sk" style="width:100%;height:36px"></span><span class="cnpy-sk" style="width:8px;height:10px"></span></span><span style="display:flex;flex-direction:column;align-items:center;gap:5px"><span class="cnpy-sk" style="width:100%;height:36px"></span><span class="cnpy-sk" style="width:8px;height:10px"></span></span></div>
      <div style="padding:10px 18px 12px;border-top:1px solid var(--border)"><span class="cnpy-sk" style="width:60px;height:8px;margin:4px 0 11px"></span><div style="display:flex;gap:6px"><span class="cnpy-sk" style="width:74px;height:24px"></span><span class="cnpy-sk" style="width:58px;height:24px"></span><span class="cnpy-sk" style="width:86px;height:24px"></span></div></div></div></div></section><section class="cnpy-surface cnpy-rise" style="min-width:0;overflow:hidden" data-screen-label="Feed · Waiting on review"><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px 8px"><span style="font-size:14px;font-weight:500">Waiting on review</span><button data-act="goReview" class="mw-more" style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;color:var(--fg-40);white-space:nowrap;padding:0">Review<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button></div><div class="cnpy-skel" data-skel="feed-review" aria-busy="true"><span class="cnpy-sr" role="status">Loading&hellip;</span><div class="cnpy-skel-in" aria-hidden="true"><div style="padding:9px 18px;border-top:1px solid var(--border)"><span class="cnpy-skl" style="height:19px"><span class="cnpy-sk" style="width:72%;height:9px"></span></span><div style="margin-top:3px"><span class="cnpy-skl" style="height:18px"><span class="cnpy-sk" style="width:52%;height:9px"></span></span></div></div><div style="padding:9px 18px;border-top:1px solid var(--border)"><span class="cnpy-skl" style="height:19px"><span class="cnpy-sk" style="width:58%;height:9px"></span></span><div style="margin-top:3px"><span class="cnpy-skl" style="height:18px"><span class="cnpy-sk" style="width:38%;height:9px"></span></span></div></div></div></div></section></aside>
    </div>
  </div></div>
    </main>
    <div class="cnpy-scrim" data-act="closeDrawer" aria-hidden="true"></div>
  </div>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
  </div>"
`;

exports[`field absent — each screen renders exactly what it did before the AI kit > My Work (no \`brief\`) 1`] = `
"<div data-cnpy-theme="light" data-screen="mywork" data-collapsed="0" data-narrow="0" data-phone="0" data-drawer="0" data-author="all" style="background:var(--bg);color:var(--fg);min-height:100vh;font-family:'Geist','Geist Fallback',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased">
    <div class="cnpy-shell" style="display:flex;height:100vh;overflow:hidden">
    <a href="#cnpy-main" class="site-skip" data-skip="cnpy-main" style="border-radius:8px">Skip to content</a>
    <aside class="cnpy-aside" data-screen-label="Sidebar">
    <div class="cnpy-logo">
      <button data-act="goSite" aria-label="About Trov" data-tip="About Trov" class="cnpy-logo-b"><svg width="24" height="24" viewBox="0 0 100 100" aria-hidden="true" style="flex:none"><path fill="var(--mark,#616ACB)" d="M0 83.72H46.51V46.51H0ZM46.51 46.51H83.72V0H46.51ZM83.72 46.51V83.72H46.51V100H100V46.51Z"></path></svg><span class="cnpy-lbl cnpy-logo-t">Trov</span></button>
    </div>
    <div class="cnpy-orgslot"><div class="cnpy-orgsw" data-tip="SaplingLearn: switch organization">
    <button type="button" data-act="orgsMenu" data-field="orgsMenu" data-orgsw-trigger class="cnpy-orgsw-b" style="border-radius:8px" aria-haspopup="dialog" aria-expanded="false" aria-controls="orgs-menu" aria-label="SaplingLearn: switch organization">
      <span class="cnpy-orgtile" aria-hidden="true" style="position:relative;overflow:hidden;width:24px;height:24px;font-size:12px;border-radius:7px">S</span>
      <span class="cnpy-lbl cnpy-orgsw-n">SaplingLearn</span>
      <span class="cnpy-lbl cnpy-badge" data-n="0" title="Nothing waiting">0</span><span class="cnpy-dot" data-n="0"></span>
      <svg class="cnpy-lbl" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;color:var(--fg-40)"><path d="m7 9 5-5 5 5"></path><path d="m7 15 5 5 5-5"></path></svg>
    </button>
  </div></div>
    <nav class="cnpy-navlist" aria-label="Primary">
      <div class="cnpy-searchwrap" data-tip="Search">
        <div data-act="sideSearchFocus" class="cnpy-search">
          <svg class="cnpy-nav-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
          <input data-act="sideSearch" data-field="sideSearch" class="cnpy-lbl cnpy-search-in" placeholder="Search Trov" aria-label="Search Trov" autocomplete="off" spellcheck="false" tabindex="0" />
          <kbd class="cnpy-lbl cnpy-kbd">Ctrl K</kbd>
        </div>
      </div>
      <div class="cnpy-sec is-first"><span class="cnpy-lbl">Workspace</span></div>
      <div class="cnpy-navrow n-mywork is-active" data-tip="My Work">
      <button data-act="goMyWork" class="cnpy-nav-i" aria-label="My Work" aria-current="page"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 12 12 3l9 9"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path></svg><span class="cnpy-lbl cnpy-nav-t">My Work</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-ask" data-tip="Trov">
      <button data-act="goAsk" class="cnpy-nav-i" aria-label="Trov"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="2.6"></circle><circle cx="5" cy="5.5" r="1.9"></circle><circle cx="19" cy="6.5" r="1.9"></circle><circle cx="17.5" cy="19" r="1.9"></circle><circle cx="5.5" cy="17.5" r="1.9"></circle><path d="M10 10.2 6.4 6.9M14.2 10.7l3.3-2.7M13.6 14.1l2.7 3.3M10 13.8l-3.1 2.4"></path></svg><span class="cnpy-lbl cnpy-nav-t">Trov</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-tickets" data-tip="Tickets">
      <button data-act="goTickets" class="cnpy-nav-i" aria-label="Tickets"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"></path><path d="M13 5v2M13 11v2M13 17v2"></path></svg><span class="cnpy-lbl cnpy-nav-t">Tickets</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>

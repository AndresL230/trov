exports[`field absent — each screen renders exactly what it did before the AI kit > Platform › Usage and an organization's usage (no \`ai\`) > usage 1`] = `
"<div class="cnpy-lead"><p class="cnpy-lead-t"><strong>1 of 1</strong> organization active in 7 days &middot; busiest <strong>Acme</strong>. Sizes and counts only: no organization's content is read here.</p><div class="cnpy-lead-a"><div class="cnpy-seg cnpy-seg--sm" data-seg="plat-usage-days" data-morph-key="seg:plat-usage-days" role="group" aria-label="Usage window"><span class="cnpy-seg-ind" aria-hidden="true" data-keep></span><button type="button" tabindex="0" data-field="seg:plat-usage-days:7" class="cnpy-seg-btn is-on" aria-pressed="true">7 days</button><button type="button" tabindex="-1" data-field="seg:plat-usage-days:30" class="cnpy-seg-btn" data-act="platUsageDays" data-arg="30" aria-pressed="false">30 days</button><button type="button" tabindex="-1" data-field="seg:plat-usage-days:90" class="cnpy-seg-btn" data-act="platUsageDays" data-arg="90" aria-pressed="false">90 days</button></div></div></div><div class="cnpy-surface plat-cq" style="overflow:hidden"><div class="repo-cells"><div class="plat-tiles"><div style="padding:16px 20px">

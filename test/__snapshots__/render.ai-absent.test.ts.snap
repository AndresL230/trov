    <div style="min-width:0;display:flex;flex-direction:column;gap:6px;padding:14px 16px">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:2px 10px"><span style="font-size:14px;font-weight:500;white-space:nowrap">Artifacts</span><button data-act="goArtifacts" class="mw-more" style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;color:var(--fg-40);white-space:nowrap;padding:0">Library<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button></div><div class="cnpy-skel" data-skel="mw-lib-arts" aria-busy="true"><span class="cnpy-sr" role="status">Loading&hellip;</span><div class="cnpy-skel-in" aria-hidden="true"><span class="cnpy-skl" style="height:20px"><span class="cnpy-sk" style="width:38%;height:9px"></span></span><span style="display:block;margin-top:6px"><span class="cnpy-skl" style="height:19px"><span class="cnpy-sk" style="width:64%;height:9px"></span></span></span></div></div></div><div class="mw-libdiv" style="background:var(--border)"></div>

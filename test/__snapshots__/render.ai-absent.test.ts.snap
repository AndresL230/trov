      <div style="min-width:0"><section class="cnpy-surface cnpy-rise" style="min-width:0;padding:18px 20px">
    <div style="font-size:12px;font-weight:500;color:var(--fg-40);margin:0 0 8px">What's happening</div>
    <div class="cnpy-md"><div class="mock-live-md">Now: hosting. Next: billing.</div></div>
  </section><div style="display:flex;align-items:center;gap:9px;margin:28px 0 12px"><span style="width:7px;height:7px;border-radius:50%;flex:none;background:var(--amber)"></span><span style="font-size:11px;font-weight:600;font-family:var(--label);text-transform:uppercase;letter-spacing:.1em;color:var(--amber)">In Progress</span><div style="flex:1;height:1px;background:var(--border)"></div></div><div class="cnpy-stagger"><div class="cnpy-surface" style="padding:14px 16px;margin-bottom:8px">
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px">
      <span style="font-size:14.5px;font-weight:600;letter-spacing:-0.01em">Hosting screens</span>
      
      

      <div id="cnpy-main" tabindex="-1" class="cnpy-scroll" style="flex:1;overflow-y:auto;min-height:0"><div class="cnpy-scroll" style="max-width:var(--frame-dash);margin:0 auto;padding:28px 32px 80px">
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6px 16px;margin-bottom:22px;min-width:0">
      <div style="min-width:0">
        <h2 style="font-size:22px;font-weight:500;letter-spacing:-0.02em;margin:0;line-height:1.2">Good afternoon, Alice</h2>
        <div style="font-size:13.5px;color:var(--fg-55);margin-top:6px;text-wrap:balance">2 tickets open</div>
      </div>
      <div style="font-size:13.5px;color:var(--fg-55);white-space:nowrap">Wednesday, October 14</div>
    </div>
    <div class="mw-main"><div class="mw-bento cnpy-stagger"><section class="cnpy-surface mw-tile cnpy-rise" style="min-width:0;display:flex;flex-direction:column;overflow:hidden;--span:7" data-mw="tickets" data-screen-label="My Work · Tickets for you"><div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px 0">
    <span style="display:inline-flex;align-items:baseline;gap:8px;min-width:0;white-space:nowrap"><span style="font-size:14px;font-weight:500">Tickets for you</span></span><button data-act="goTickets" class="mw-more" style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;color:var(--fg-40);white-space:nowrap;padding:0">Queue<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
  </div><div style="font-size:13px;color:var(--fg-55);padding:2px 16px 10px">2 open</div><div class="mw-scroll" style="display:flex;flex-direction:column;flex:1"><button data-act="openTicket" data-arg="12" class="mw-row" style="display:flex;align-items:flex-start;gap:12px;width:100%;text-align:left;padding:10px 16px;border-top:1px solid var(--border)">
    <span style="font-family:var(--label);font-size:12px;font-weight:600;color:var(--fg);flex:none;margin-top:2px;width:44px">High</span>
    <span style="flex:1;min-width:0;display:block">
      <span style="display:block;font-size:14px;font-weight:500;color:var(--fg);line-height:1.4;text-wrap:pretty">SSO login loops on Safari</span>
      <span style="display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-top:3px;font-size:12.5px;color:var(--fg-40)">

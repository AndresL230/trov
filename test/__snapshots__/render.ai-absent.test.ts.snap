    <div style="font-size:11.5px;color:var(--fg-40);margin-top:10px">2026-10-08 to 2026-10-14 (UTC), most active first. Open a row for what was created, its AI summaries and its most used MCP tools.</div>"
`;

exports[`field absent — each screen renders exactly what it did before the AI kit > Repo › Overview and › Planning (no \`state\`, no \`themes\`) > overview 1`] = `
"<div data-cnpy-theme="light" data-screen="repo" data-collapsed="0" data-narrow="0" data-phone="0" data-drawer="0" data-author="all" style="background:var(--bg);color:var(--fg);min-height:100vh;font-family:'Geist','Geist Fallback',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased">

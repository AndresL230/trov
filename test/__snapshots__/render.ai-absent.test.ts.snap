    <main style="flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bg)">
      <header class="cnpy-hdr" style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 var(--hdr-pr, 24px) 0 var(--hdr-pl, 24px);min-height:57px;border-bottom:1px solid var(--border);flex:none">
    <div class="cnpy-hdr-l" style="display:flex;align-items:center;gap:12px;min-width:0">
      <button data-act="openDrawer" class="cnpy-menubtn cnpy-iconbtn" aria-label="Open navigation" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button><h1 style="font-size:15px;font-weight:600;letter-spacing:-0.01em;margin:0">Repo</h1>
      <span style="font-family:var(--label);font-size:11px;color:var(--fg-40);white-space:nowrap;min-width:0;overflow:hidden;text-overflow:ellipsis">acme/web</span>
    </div>
    <div class="cnpy-hdr-r" style="display:flex;align-items:center;gap:8px;flex:none">
      <div data-sync-slot="ctl" class="sync-slot"></div><span data-mtip="staging: Degraded. Checks are failing on the branch head." style="display:inline-flex;align-items:center;gap:7px;font-size:12px;white-space:nowrap;color:var(--fg-70)"><span class="repo-envdot repo-pulse" style="--c:var(--amber);width:7px;height:7px;border-radius:50%;background:var(--amber);box-shadow:0 0 0 3px color-mix(in srgb,var(--amber) 16%,transparent)"></span>staging</span><span data-mtip="production: Failing. A deploy part failed." style="display:inline-flex;align-items:center;gap:7px;font-size:12px;white-space:nowrap;color:var(--fg-70)"><span class="repo-envdot repo-pulse" style="--c:var(--red);width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 0 3px color-mix(in srgb,var(--red) 16%,transparent)"></span>production</span><div style="width:1px;height:20px;background:var(--border);margin:0 2px"></div>
    <span data-repo-updated style="font-size:11.5px;color:var(--fg-40);white-space:nowrap">updated just now</span><button data-act="repoPollNow" title="Poll deploys, CI, usage and health now (admin) — issues refresh with Sync GitHub" aria-label="Poll deploys, CI, usage and health now (admin) — issues refresh with Sync GitHub" class="cnpy-outlinebtn repo-pollbtn" style="height:32px;padding:0 12px;border-radius:8px;border:1px solid var(--border);display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:500;white-space:nowrap;color:var(--fg-55);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg><span class="repo-pollbtn-label">Poll now</span>
    </button>
    <button data-act="repoRefresh" title="Reload from Trov's database" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path><path d="M21 3v5h-5"></path></svg>
    </button><button data-act="supportOpen" data-arg="bug" data-support-trigger="bug" title="Report a bug" aria-label="Report a bug" aria-haspopup="dialog" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="7" width="8" height="12" rx="4"></rect><path d="M12 12v7"></path><path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path><path d="M4 13h4M16 13h4M5 7l3.2 2.6M19 7l-3.2 2.6M5 20l3.2-2.8M19 20l-3.2-2.8"></path></svg>
    </button><button data-act="cycleTheme" title="Toggle theme" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path></svg>
    </button>
    </div>
  </header>
      <div id="cnpy-main" tabindex="-1" class="cnpy-scroll" style="flex:1;overflow-y:auto;min-height:0"><div class="repo-frame" style="max-width:var(--frame-dash);margin:0 auto;padding:22px 32px 36px" data-screen-label="Overview">
    <div class="cnpy-tabs" data-tabs="repo-tab" data-morph-key="tabs:repo-tab" role="tablist" aria-label="Repo sections"><span class="cnpy-tabs-ind" aria-hidden="true" data-keep></span><button type="button" role="tab" id="repo-tab-overview" class="cnpy-tab is-on" aria-selected="true" aria-controls="repo-tab-panel" tabindex="0" data-field="tab:repo-tab:overview">Overview</button><button type="button" role="tab" id="repo-tab-code" class="cnpy-tab" data-act="setRepoTab" data-arg="code" aria-selected="false" aria-controls="repo-tab-panel" tabindex="-1" data-field="tab:repo-tab:code">Code</button><button type="button" role="tab" id="repo-tab-ci" class="cnpy-tab" data-act="setRepoTab" data-arg="ci" aria-selected="false" aria-controls="repo-tab-panel" tabindex="-1" data-field="tab:repo-tab:ci">CI &amp; Deploys</button><button type="button" role="tab" id="repo-tab-usage" class="cnpy-tab" data-act="setRepoTab" data-arg="usage" aria-selected="false" aria-controls="repo-tab-panel" tabindex="-1" data-field="tab:repo-tab:usage">Usage</button><button type="button" role="tab" id="repo-tab-planning" class="cnpy-tab" data-act="setRepoTab" data-arg="planning" aria-selected="false" aria-controls="repo-tab-panel" tabindex="-1" data-field="tab:repo-tab:planning">Team &amp; Planning</button></div>
    <div role="tabpanel" id="repo-tab-panel" aria-labelledby="repo-tab-overview" data-morph-key="repo-tab-panel:overview" style="padding-top:20px">
      
      
      <div class="repo-panel cnpy-surface" style="display:flex;flex-direction:column;overflow:hidden"><div class="cnpy-rise" style="--i:0;"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr))"><div style="padding:20px 22px 10px;min-width:0;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
          <span style="font-size:16.5px;font-weight:600;letter-spacing:-0.01em;flex:1">staging <span style="font-size:11.5px;font-weight:500;color:var(--fg-40)">main</span></span>
          <span data-mtip="Checks are failing on the branch head." style="display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:var(--fg-70);white-space:nowrap"><svg width="9" height="9" viewBox="0 0 10 10" fill="none" style="flex:none;display:block;color:var(--amber)" aria-hidden="true"><path d="M5 .8 9.5 9H.5Z" fill="currentColor"/></svg>Degraded</span>
        </div>
        <div style="display:grid;grid-template-columns:96px 1fr;gap:12px;padding:11px 0;border-top:1px solid var(--border)"><div style="font-family:var(--label);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);white-space:nowrap;padding-top:2px">Frontend</div><div style="font-size:13.5px;line-height:1.6;color:var(--fg-70);display:flex;align-items:center;gap:9px;flex-wrap:wrap"><span style="font-family:var(--label);font-size:12.5px;color:var(--fg);background:var(--hover);border:1px solid var(--border);border-radius:4px;padding:0 5px">a3f82c1</span><span style="font-size:12px;color:var(--fg-40);white-space:nowrap">22m ago · by dev-raj · Cloudflare Workers</span></div></div><div style="display:grid;grid-template-columns:96px 1fr;gap:12px;padding:11px 0;border-top:1px solid var(--border)"><div style="font-family:var(--label);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);white-space:nowrap;padding-top:2px">Backend</div><div style="font-size:13.5px;line-height:1.6;color:var(--fg-70);display:flex;align-items:center;gap:9px;flex-wrap:wrap"><span style="font-family:var(--label);font-size:12.5px;color:var(--fg);background:var(--hover);border:1px solid var(--border);border-radius:4px;padding:0 5px">a3f82c1</span><span style="font-size:12px;color:var(--fg-40);white-space:nowrap">24m ago · by dev-raj · Railway</span></div></div><div style="display:grid;grid-template-columns:96px 1fr;gap:12px;padding:11px 0;border-top:1px solid var(--border)"><div style="font-family:var(--label);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);white-space:nowrap;padding-top:2px">Marketing site</div><div style="font-size:13.5px;line-height:1.6;color:var(--fg-70);display:flex;align-items:center;gap:9px;flex-wrap:wrap"><span style="font-family:var(--label);font-size:12.5px;color:var(--fg);background:var(--hover);border:1px solid var(--border);border-radius:4
  </aside>
    <main style="flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bg)">
      <header class="cnpy-hdr" style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 24px;min-height:57px;border-bottom:1px solid var(--border);flex:none">
    <div class="cnpy-hdr-l" style="display:flex;align-items:center;gap:12px;min-width:0">
      <button data-act="openDrawer" class="cnpy-menubtn cnpy-iconbtn" aria-label="Open navigation" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button><h1 style="font-size:15px;font-weight:600;letter-spacing:-0.01em;margin:0;white-space:nowrap;flex:none"><button data-act="ticketsBack" style="font-size:15px;font-weight:600;letter-spacing:-0.01em;padding:0;color:var(--fg-55);cursor:pointer">Tickets</button></h1>
      <span style="display:inline-flex;align-items:center;gap:10px;min-width:0"><span style="color:var(--fg-40);font-size:15px">›</span><span style="font-size:15px;font-weight:600;letter-spacing:-0.01em;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0">Login page shows a blank screen on Safari</span></span>
    </div>
    <div class="cnpy-hdr-r" style="display:flex;align-items:center;gap:8px;flex:none">
      <button type="button" class="ask-ghostbtn ask-ghostbtn--outline" data-act="askCjOpen" aria-haspopup="dialog" aria-expanded="false" aria-keyshortcuts="Control+J"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;display:block"><circle cx="12" cy="12" r="2.6"></circle><circle cx="5" cy="5.5" r="1.9"></circle><circle cx="19" cy="6.5" r="1.9"></circle><circle cx="17.5" cy="19" r="1.9"></circle><circle cx="5.5" cy="17.5" r="1.9"></circle><path d="M10 10.2 6.4 6.9M14.2 10.7l3.3-2.7M13.6 14.1l2.7 3.3M10 13.8l-3.1 2.4"></path></svg>Ask about this<kbd class="ask-kbd">Ctrl J</kbd></button><div data-sync-slot="ctl" class="sync-slot"></div><button data-act="supportOpen" data-arg="bug" data-support-trigger="bug" title="Report a bug" aria-label="Report a bug" aria-haspopup="dialog" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="7" width="8" height="12" rx="4"></rect><path d="M12 12v7"></path><path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path><path d="M4 13h4M16 13h4M5 7l3.2 2.6M19 7l-3.2 2.6M5 20l3.2-2.8M19 20l-3.2-2.8"></path></svg>
    </button><button data-act="cycleTheme" title="Toggle theme" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path></svg>
    </button>
    </div>
  </header>
      <div id="cnpy-main" tabindex="-1" class="cnpy-scroll" style="flex:1;overflow-y:auto;min-height:0"><div style="width:100%;max-width:1120px;margin:0 auto;padding:26px clamp(20px,2.6 * var(--vw),46px) 100px">
    <div class="cnpy-td-grid" style="display:grid;grid-template-columns:minmax(0,1fr) 258px;gap:34px;min-height:calc(100 * var(--vh) - 210px)">
      <div style="min-width:0;display:flex;flex-direction:column">
        <div style="display:flex;align-items:flex-start;gap:10px;margin:0 0 22px">
          <h2 style="margin:0;flex:1;min-width:0;font-size:22px;font-weight:600;letter-spacing:-0.02em">Login page shows a blank screen on Safari</h2>
          <button data-act="ticketEdit" title="Edit title and description" aria-label="Edit title and description" class="cnpy-iconbtn" style="width:22px;height:22px;border-radius:6px;display:grid;place-items:center;color:var(--fg-40);transition:all .12s ease;flex:none;margin-top:3px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.4 2.6a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z"></path><path d="M20 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5"></path></svg></button>
        </div>
        <div class="cnpy-md cnpy-td-body" style="font-size:13.5px;line-height:1.65;color:var(--fg-70);max-width:640px"><div class="mock-live-md">Since this morning the login page is blank on Safari 18. Chrome works.</div></div>
        <div style="display:flex;align-items:baseline;gap:10px;margin-top:26px">
      <div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);white-space:nowrap;flex:none">Linked work</div>
    </div><div style="display:flex;gap:8px;margin-top:10px">
        <input data-act="ticketLinkDraft" data-field="ticketLinkDraft" value="" placeholder="Paste a GitHub or Figma URL, or #issue — it links on paste or Enter" style="flex:1;height:36px;padding:0 12px;border:1px solid var(--border-strong);border-radius:8px;background:transparent;color:var(--fg);font-size:12.5px;font-family:var(--label);outline:none" />
        <button data-act="ticketLinkAdd" class="cnpy-outlinebtn" style="padding:0 14px;border-radius:8px;border:1px solid var(--border-strong);font-size:12.5px;font-weight:500;color:var(--fg-70);transition:all .12s ease">Link</button>
      </div>
        <div data-screen-label="Attached artifacts" style="display:flex;align-items:baseline;gap:10px;margin-top:26px">
      <div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);flex:none">Artifacts</div>
      <span style="font-family:var(--label);font-size:10.5px;font-weight:600;color:var(--fg-40)">–</span>
    </div><div class="cnpy-skel" data-skel="ticket-artifacts" aria-busy="true" style="margin-top:10px"><span class="cnpy-sr" role="status">Loading artifacts&hellip;</span><div class="cnpy-skel-in" aria-hidden="true"><span class="cnpy-skl" style="height:18px"><span class="cnpy-sk" style="width:220px;height:9px"></span></span></div></div>
        <div style="display:flex;flex-direction:column;flex:1;min-height:0">
    <div style="display:flex;align-items:baseline;justify-content:space-between;margin-top:30px;padding-bottom:9px;border-bottom:1px solid var(--border-strong);flex:none">
      <div style="font-family:var(--label);font-size:11px;font-weight:600;letter-spacing:.08em;color:var(--fg-55);white-space:nowrap;flex:none">THREAD</div>
      <div style="font-family:var(--label);font-size:10.5px;font-weight:600;color:var(--fg-40);white-space:nowrap;flex:none">0 comments</div>
    </div>
    <div style="flex:1;min-height:0"><div style="display:flex;align-items:center;gap:9px;padding:8px 0 8px 8px;border-bottom:1px solid var(--border)">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--border-strong);flex:none;margin:0 6px"></span>
        <button data-act="openPerson" data-arg="alice" class="cnpy-personchip" title="Alice" style="display:inline-flex;align-items:center;gap:7px;min-width:0;max-width:calc(100% + 10px);text-align:left;padding:2px 8px 2px 2px;margin:-2px -8px -2px -2px;border-radius:7px"><div class="cnpy-av" title="Alice" style="--c:var(--p-moss);position:relative;width:16px;height:16px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AL</div><span style="font-size:12px;font-weight:600;color:var(--fg-70);white-space:nowrap">Alice</span></button>
        <span style="font-size:12px;color:var(--fg-40);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">opened this ticket</span>
        <span style="font-size:11px;color:var(--fg-40);margin-left:auto;flex:none;white-space:nowrap">2h ago</span>
      </div></div>
    <div class="cnpy-surface" style="position:relative;padding:12px;margin-top:16px;flex:none">
      <div style="position:relative">
        <textarea data-act="ticketComment" data-field="ticketComment" placeholder="Write a comment — @mention to loop someone in…" style="display:block;width:100%;height:96px;min-height:60px;padding:2px 0 36px;border:none;outline:none;background:transparent;color:var(--fg);font-size:13.5px;line-height:1.6;resize:none"></textarea>
        
      </div>
      <button data-act="commentGrip" title="Drag to resize" aria-label="Resize the comment box" class="cnpy-grip" style="position:absolute;left:10px;bottom:10px;width:12px;height:12px;display:grid;place-items:center;color:var(--fg-40);cursor:ns-resize;touch-action:none"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M1 1 11 11"></path><path d="M1 6 6 11"></path></svg></button>
      <button data-act="ticketCommentPost" data-arg="" class="" style="background:transparent;color:var(--fg-40);border:1px solid var(--border);cursor:default;border-radius:8px;padding:7px 15px;font-size:12.5px;font-weight:600;transition:all .12s ease;position:absolute;right:8px;bottom:8px">Comment</button>
    </div>
  </div>
      </div>
      <div style="border-left:1px solid var(--border);padding-left:26px;display:flex;flex-direction:column;gap:26px">
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;height:22px;margin-bottom:6px"><div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);white-space:nowrap">Properties</div></div>
          <div style="display:grid;grid-template-columns:76px 1fr;gap:10px;align-items:center;height:30px"><div style="font-family:var(--label);font-size:10px;font-weight:600;letter-spacing:.06em;color:var(--fg-40)">STATUS</div><div style="min-width:0"><div style="position:relative;display:inline-flex">
    <button data-act="ticketStatusMenu" data-arg="rail" title="Set status" aria-haspopup="menu" aria-expanded="false" class="cnpy-statusbtn" style="display:inline-flex;align-items:center;gap:6px;margin:-4px 0 -4px -6px;padding:4px 6px;border-radius:6px;font-size:12.5px;font-weight:500;color:var(--fg);white-space:nowrap;cursor:pointer">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="flex:none;display:block;color:var(--fg-55)" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.4 1.9"/></svg>Triage
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" style="flex:none;color:var(--fg-40)"><path d="m6 9 6 6 6-6"></path></svg>
    </button>
  </div></div></div>
          <div style="display:grid;grid-template-columns:76px 1fr;gap:10px;align-items:center;height:30px"><div style="font-family:var(--label);font-size:10px;font-weight:600;letter-spacing:.06em;color:var(--fg-40)">CATEGORY</div><div style="font-size:12.5px;color:var(--fg-70)">other</div></div>
          <div style="display:grid;grid-template-columns:76px 1fr;gap:10px;align-items:center;height:30px"><div style="font-family:var(--label);font-size:10px;font-weight:600;letter-spacing:.06em;color:var(--fg-40)">PRIORITY</div><div><span data-mtip="Normal priority" style="display:inline-flex;align-items:center;gap:6px;font-size:12.5px;color:var(--fg-70);white-space:nowrap"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="flex:none;display:block;color:var(--fg-70)" aria-hidden="true"><rect x="1.5" y="8" width="2.6" height="4.5" rx=".6" fill="currentColor"/><rect x="5.7" y="5" width="2.6" height="7.5" rx=".6" fill="currentColor"/><rect x="9.9" y="2" width="2.6" height="10.5" rx=".6" fill="currentColor" opacity=".25"/></svg>Normal</span></div></div>
          <div style="display:grid;grid-template-columns:76px 1fr;gap:10px;align-items:center;height:30px"><div style="font-family:var(--label);font-size:10px;font-weight:600;letter-spacing:.06em;color:var(--fg-40)">REQUESTER</div><div style="display:flex;min-width:0"><button data-act="openPerson" data-arg="alice" class="cnpy-personchip" title="Alice" style="display:inline-flex;align-items:center;gap:7px;min-width:0;max-width:calc(100% + 10px);text-align:left;padding:2px 8px 2px 2px;margin:-2px -8px -2px -2px;border-radius:7px"><div class="cnpy-av" title="Alice" style="--c:var(--p-moss);position:relative;width:20px;height:20px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AL</div><span style="min-width:0;font-size:12.5px;font-weight:500;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Alice</span></button></div></div>
          
          <div style="display:grid;grid-template-columns:76px 1fr;gap:10px;align-items:center;height:30px"><div style="font-family:var(--label);font-size:10px;font-weight:600;letter-spacing:.06em;color:var(--fg-40)">OPENED</div><div style="font-size:12.5px;color:var(--fg-70);white-space:nowrap">2h ago</div></div>
        </div>
        <div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;height:22px;margin-bottom:6px">
      <div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);white-space:nowrap">Assignees</div>
      <div style="position:relative;display:flex;align-items:center"><button data-act="ticketAsgMenu" title="Add assignee" class="cnpy-iconbtn" style="width:22px;height:22px;border-radius:6px;display:grid;place-items:center;color:var(--fg-40);transition:all .12s ease"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg></button></div>
    </div><div style="display:flex;align-items:center;gap:10px;height:34px">
        <div style="width:24px;height:24px;border-radius:50%;border:1px dashed var(--border-strong);display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--fg-40);flex:none">–</div>
        <span style="font-size:12.5px;color:var(--fg-40);font-style:italic">Unassigned</span>
      </div>
  </div>
        <div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;height:22px;margin-bottom:6px">
      <div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);white-space:nowrap">Sprint</div>
      <div style="position:relative;display:flex;align-items:center">
        <button data-act="ticketSprintMenu" title="Change sprint" class="cnpy-iconbtn" style="width:22px;height:22px;border-radius:6px;display:grid;place-items:center;color:var(--fg-40);transition:all .12s ease"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"></path><path d="M18.4 2.6a2.1 2.1 0 0 1 3 3L13 14l-4 1 1-4z"></path></svg></button>
      </div>
    </div>
    <button style="display:flex;align-items:center;gap:10px;width:100%;text-align:left;height:38px;padding:0;cursor:default">
      <span style="width:24px;height:24px;border-radius:6px;border:1px solid var(--border-strong);display:grid;place-items:center;color:var(--fg-55);flex:none"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 21V4"></path><path d="M5 4.5C7 3 9 3 12 4.5s5 1.5 7 0V13c-2 1.5-4 1.5-7 0s-5-1.5-7 0"></path></svg></span>
      <span style="flex:1;min-width:0">
        <span style="display:block;font-size:13px;font-weight:500;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Backlog</span>
        <span style="display:block;font-family:var(--label);font-size:9.5px;font-weight:600;letter-spacing:.04em;color:var(--fg-40);white-space:nowrap;margin-top:2px">NO SPRINT</span>
      </span>
      
    </button>
  </div>
        <div>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;height:22px;margin-bottom:6px">
      <div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40);white-space:nowrap">Relations</div>
      <div style="position:relative;display:flex;align-items:center"></div>
    </div><div style="display:flex;align-items:center;gap:10px;height:34px">
        <div style="width:24px;height:24px;border-radius:6px;border:1px dashed var(--border-strong);display:grid;place-items:center;font-size:11px;color:var(--fg-40);flex:none">↳</div>
        <span style="font-size:12.5px;color:var(--fg-40);font-style:italic">No linked tickets</span>
      </div>
  </div>
        <div><button type="button" data-act="ticketDeleteArm" data-confirm-trigger class="cnpy-dangerbtn" aria-haspopup="dialog" aria-expanded="false" aria-controls="ticket-delete-confirm" style="display:inline-flex;align-items:center;gap:6px;padding:8px 12px;border-radius:8px;border:1px solid var(--border-strong);font-size:12.5px;font-weight:500;color:var(--fg-55);white-space:nowrap"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path><path d="M10 11v6M14 11v6"></path></svg>Delete ticket</button></div>
      </div>
    </div>
  </div></div>
    </main>
    <div class="cnpy-scrim" data-act="closeDrawer" aria-hidden="true"></div>
  </div>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
  </div>"
`;

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`field absent — each screen renders exactly what it did before Phase C > Review (no row carries \`ai\`) 1`] = `
"<div data-cnpy-theme="light" data-screen="review" data-collapsed="0" data-narrow="0" data-phone="0" data-drawer="0" data-author="all" style="background:var(--bg);color:var(--fg);min-height:calc(100 * var(--vh));font-family:'Geist','Geist Fallback',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased">
    <div class="cnpy-shell" style="display:flex;height:calc(100 * var(--vh));overflow:hidden">
    <a href="#cnpy-main" class="site-skip" data-skip="cnpy-main" style="border-radius:8px">Skip to content</a>
    <aside class="cnpy-aside" data-screen-label="Sidebar">
    <div class="cnpy-logo">
      <button data-act="goSite" aria-label="About Trov" data-tip="About Trov" class="cnpy-logo-b"><svg width="24" height="24" viewBox="0 0 100 100" aria-hidden="true" style="flex:none"><path fill="var(--mark,#616ACB)" d="M0 83.72H46.51V46.51H0ZM46.51 46.51H83.72V0H46.51ZM83.72 46.51V83.72H46.51V100H100V46.51Z"></path></svg><span class="cnpy-lbl cnpy-logo-t">Trov</span></button>
    </div>
    <div class="cnpy-orgslot"><div class="cnpy-orgsw" data-tip="SaplingLearn: switch organization">
    <button type="button" data-act="orgsMenu" data-field="orgsMenu" data-orgsw-trigger class="cnpy-orgsw-b" style="border-radius:8px" aria-haspopup="dialog" aria-expanded="false" aria-controls="orgs-menu" aria-label="SaplingLearn: switch organization">
      <span class="cnpy-orgtile" aria-hidden="true" style="position:relative;overflow:hidden;width:24px;height:24px;font-size:12px;border-radius:7px">S</span>
      <span class="cnpy-lbl cnpy-orgsw-n">SaplingLearn</span>
      <span class="cnpy-lbl cnpy-badge" data-n="0" title="Nothing waiting">0</span><span class="cnpy-dot" data-n="0"></span>
      <svg class="cnpy-lbl" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;color:var(--fg-40)"><path d="m7 9 5-5 5 5"></path><path d="m7 15 5 5 5-5"></path></svg>
    </button>
  </div></div>
    <nav class="cnpy-navlist" aria-label="Primary">
      <div class="cnpy-searchwrap" data-tip="Search">
        <div data-act="sideSearchFocus" class="cnpy-search">
          <svg class="cnpy-nav-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
          <input data-act="sideSearch" data-field="sideSearch" class="cnpy-lbl cnpy-search-in" placeholder="Search Trov" aria-label="Search Trov" autocomplete="off" spellcheck="false" tabindex="0" />
          <kbd class="cnpy-lbl cnpy-kbd">Ctrl K</kbd>
        </div>
      </div>
      <div class="cnpy-sec is-first"><span class="cnpy-lbl">Workspace</span></div>
      <div class="cnpy-navrow n-home" data-tip="Home">
      <button data-act="goHome" class="cnpy-nav-i" aria-label="Home"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9"></path></svg><span class="cnpy-lbl cnpy-nav-t">Home</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-mywork" data-tip="My Work">
      <button data-act="goMyWork" class="cnpy-nav-i" aria-label="My Work"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path><path d="M3 12.5h18"></path></svg><span class="cnpy-lbl cnpy-nav-t">My Work</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-ask" data-tip="Trov">
      <button data-act="goAsk" class="cnpy-nav-i" aria-label="Trov"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="2.6"></circle><circle cx="5" cy="5.5" r="1.9"></circle><circle cx="19" cy="6.5" r="1.9"></circle><circle cx="17.5" cy="19" r="1.9"></circle><circle cx="5.5" cy="17.5" r="1.9"></circle><path d="M10 10.2 6.4 6.9M14.2 10.7l3.3-2.7M13.6 14.1l2.7 3.3M10 13.8l-3.1 2.4"></path></svg><span class="cnpy-lbl cnpy-nav-t">Trov</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-tickets" data-tip="Tickets">
      <button data-act="goTickets" class="cnpy-nav-i" aria-label="Tickets"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"></path><path d="M13 5v2M13 11v2M13 17v2"></path></svg><span class="cnpy-lbl cnpy-nav-t">Tickets</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-roadmap" data-tip="Roadmap">
      <button data-act="goRoadmap" class="cnpy-nav-i" aria-label="Roadmap"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4"></path><path d="M5 4.5C7 3 9 3 12 4.5s5 1.5 7 0V13c-2 1.5-4 1.5-7 0s-5-1.5-7 0"></path></svg><span class="cnpy-lbl cnpy-nav-t">Roadmap</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-handoffs" data-tip="Relay">
      <button data-act="goRelay" class="cnpy-nav-i" aria-label="Relay"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3l4 4-4 4"></path><path d="M20 7H4"></path><path d="M8 21l-4-4 4-4"></path><path d="M4 17h16"></path></svg><span class="cnpy-lbl cnpy-nav-t">Relay</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-sec"><span class="cnpy-lbl">Monitor</span></div>
      <div class="cnpy-navrow n-repo" data-tip="Repo">
      <button data-act="goRepo" class="cnpy-nav-i" aria-label="Repo"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3v12"></path><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg><span class="cnpy-lbl cnpy-nav-t">Repo</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-feed" data-tip="Feed">
      <button data-act="goFeed" class="cnpy-nav-i" aria-label="Feed"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h10"></path></svg><span class="cnpy-lbl cnpy-nav-t">Feed</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-sec"><span class="cnpy-lbl">Knowledge</span></div>
      <div class="cnpy-navrow n-library" data-tip="Library">
      <button data-act="goLibrary" class="cnpy-nav-i" aria-label="Library"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg><span class="cnpy-lbl cnpy-nav-t">Library</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button><button data-act="navToggle" data-arg="library" class="cnpy-chev" aria-label="Show or hide spaces" aria-expanded="false" tabindex="0"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></button>
    </div><div class="cnpy-sub" data-open="0"><div class="cnpy-sub-clip"><div class="cnpy-sub-list"><div class="cnpy-sub-none" hidden>No spaces yet<div class="cnpy-sub-ghost" aria-hidden="true"><span></span><span></span></div></div></div></div></div>
      <div class="cnpy-navrow n-artifacts" data-tip="Artifacts">
      <button data-act="goArtifacts" class="cnpy-nav-i" aria-label="Artifacts"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg><span class="cnpy-lbl cnpy-nav-t">Artifacts</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-prompts" data-tip="Prompt Library">
      <button data-act="goPrompts" class="cnpy-nav-i" aria-label="Prompt Library"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 18l6-6-6-6"></path><path d="M8 6l-6 6 6 6"></path></svg><span class="cnpy-lbl cnpy-nav-t">Prompt Library</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-review is-active" data-tip="Review">
      <button data-act="goReview" class="cnpy-nav-i" aria-label="Review" aria-current="page"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="m9 12 2 2 4-4"></path></svg><span class="cnpy-lbl cnpy-nav-t">Review</span><span class="cnpy-lbl cnpy-badge" data-n="2">2</span><span class="cnpy-dot" data-n="2"></span></button>
    </div>
      <div class="cnpy-sec"><span class="cnpy-lbl">Help</span></div>
      <div class="cnpy-navrow n-guide" data-tip="Guide">
      <button data-act="goGuide" class="cnpy-nav-i" aria-label="Guide"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9.5 9.5a2.6 2.6 0 0 1 5 .9c0 1.7-2.5 2.4-2.5 2.4"></path><circle cx="12" cy="16.6" r=".4" fill="currentColor"></circle></svg><span class="cnpy-lbl cnpy-nav-t">Guide</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-releases" data-tip="What&#39;s new">
      <button data-act="goReleases" class="cnpy-nav-i" aria-label="What&#39;s new"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path><path d="M19 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"></path></svg><span class="cnpy-lbl cnpy-nav-t">What&#39;s new</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
    </nav>
    <div class="cnpy-collapse" data-tip="Expand sidebar">
      <button data-act="toggleCollapse" class="cnpy-nav-i" aria-label="Collapse sidebar" aria-expanded="true"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path><path d="M14.5 9.5 12 12l2.5 2.5"></path></svg><span class="cnpy-lbl cnpy-nav-t">Collapse</span></button>
    </div>
    <div class="cnpy-ghost cnpy-lbl">agents produce · humans confirm</div>
    <div class="cnpy-foot" data-tip="Settings">
      <button data-act="goSettings" aria-label="Settings" class="cnpy-chip">
        <div class="cnpy-av" title="Alice" style="--c:var(--p-moss);position:relative;width:28px;height:28px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:10px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AL</div>
        <div class="cnpy-lbl cnpy-chip-t"><div class="cnpy-chip-n">alice</div><div class="cnpy-chip-h"><span style="font-family:var(--sans);font-size:11px;font-weight:500;color:var(--p-moss)">@alice</span></div></div>
        <svg class="cnpy-lbl" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" style="flex:none" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </button>
    </div>
    <div class="cnpy-tip" role="tooltip" data-keep></div>
  </aside>
    <main data-morph="review" style="flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bg)">
      <header class="cnpy-hdr" style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 24px;min-height:57px;border-bottom:1px solid var(--border);flex:none">
    <div class="cnpy-hdr-l" style="display:flex;align-items:center;gap:12px;min-width:0">
      <button data-act="openDrawer" class="cnpy-menubtn cnpy-iconbtn" aria-label="Open navigation" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button><h1 style="font-size:15px;font-weight:600;letter-spacing:-0.01em;margin:0">Review</h1>
      
    </div>
    <div class="cnpy-hdr-r" style="display:flex;align-items:center;gap:8px;flex:none">
      <div class="cnpy-seg cnpy-seg--md" data-seg="triage-view" data-morph-key="seg:triage-view" role="group" aria-label="Review"><span class="cnpy-seg-ind" aria-hidden="true" data-keep></span><button type="button" tabindex="0" data-field="seg:triage-view:queue" class="cnpy-seg-btn is-on" aria-pressed="true">To review<span class="cnpy-seg-n">2</span></button><button type="button" tabindex="-1" data-field="seg:triage-view:unplaced" class="cnpy-seg-btn" data-act="setReviewView" data-arg="unplaced" aria-pressed="false">Unplaced</button></div><div data-sync-slot="ctl" class="sync-slot"></div><button data-act="supportOpen" data-arg="bug" data-support-trigger="bug" title="Report a bug" aria-label="Report a bug" aria-haspopup="dialog" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="7" width="8" height="12" rx="4"></rect><path d="M12 12v7"></path><path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path><path d="M4 13h4M16 13h4M5 7l3.2 2.6M19 7l-3.2 2.6M5 20l3.2-2.8M19 20l-3.2-2.8"></path></svg>
    </button><button data-act="cycleTheme" title="Toggle theme" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path></svg>
    </button>
    </div>
  </header>
      <div id="cnpy-main" tabindex="-1" class="cnpy-scroll" style="flex:1;overflow-y:auto;min-height:0"><div class="cnpy-rv" data-view="queue" data-pane="list" style="display:flex;height:100%;min-width:0">
    <div class="cnpy-rv-list" data-morph-key="rv-list:queue" style="flex:.95 1 0;min-width:420px;border-right:1px solid var(--border);display:flex;flex-direction:column;min-height:0">
      <div class="cnpy-rv-lhead" style="padding:16px 20px 0">
        <div style="font-size:12.5px;color:var(--fg-55)">Agent-produced changes waiting for a verdict.</div>
        <div style="margin:12px 0 12px"><div class="cnpy-seg cnpy-seg--sm" data-seg="review-filter" data-morph-key="seg:review-filter" role="group" aria-label="Show"><span class="cnpy-seg-ind" aria-hidden="true" data-keep></span><button type="button" tabindex="0" data-field="seg:review-filter:all" class="cnpy-seg-btn is-on" aria-pressed="true">All<span class="cnpy-seg-n">2</span></button><button type="button" tabindex="-1" data-field="seg:review-filter:imports" class="cnpy-seg-btn" data-act="reviewFilter" data-arg="imports" aria-pressed="false">Imports<span class="cnpy-seg-n">0</span></button><button type="button" tabindex="-1" data-field="seg:review-filter:agents" class="cnpy-seg-btn" data-act="reviewFilter" data-arg="agents" aria-pressed="false">Written by agents<span class="cnpy-seg-n">2</span></button></div></div>
      </div>
      <div class="cnpy-scroll cnpy-stagger cnpy-rv-rows" data-morph-list style="flex:1;overflow-y:auto;padding:2px 14px 80px"><div class="cnpy-rv-row" data-morph-key="rvg:agent:andres"><div class="cnpy-rv-row-in"><div class="cnpy-rvg cnpy-surface" data-rv-group="agent:andres" data-kind="agent">
    <div class="cnpy-rvg-in">
      <div class="cnpy-rvg-head">
        <span class="cnpy-rvg-ic" style="border-radius:7px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path><path d="M19 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"></path></svg></span>
        <div style="min-width:0;flex:1">
          <div style="font-size:14px;font-weight:600;letter-spacing:-0.005em;color:var(--fg);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Written by Andres&#39;s agent</div>
          <div style="display:flex;align-items:center;gap:6px;margin-top:3px;font-size:12px;color:var(--fg-55);min-width:0"><span style="flex:none;display:inline-flex"><span class="cnpy-rvg-agav" role="img" aria-label="@andres&#39;s agent" style="border-radius:5px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path><path d="M19 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"></path></svg></span></span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">1 page · 4 hours ago</span></div>
        </div>
      </div>
      <div class="cnpy-rvg-acts">
        <button type="button" data-act="reviewGroupToggle" data-arg="agent:andres" class="cnpy-rvg-tog" aria-expanded="false"><span class="cnpy-rvg-chev" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span>Review one by one</button>
        <span class="cnpy-rvg-done" hidden>0 of 1 reviewed</span>
        <span style="flex:1"></span>
        <button type="button" data-act="reviewGroupReject" data-arg="agent:andres" data-confirm-trigger class="cnpy-rejectbtn" style="height:30px;padding:0 12px;border-radius:8px;border:1px solid var(--border-strong);font-size:12.5px;font-weight:500;color:var(--fg-70)">Reject all</button>
        <button type="button" data-act="reviewGroupApprove" data-arg="agent:andres" class="cnpy-accentbtn" style="height:30px;padding:0 13px;border-radius:8px;background:var(--accent);color:var(--accent-fg);font-size:12.5px;font-weight:600;white-space:nowrap">Approve all 1</button>
      </div>
      <div class="cnpy-rvg-list" data-open="0"><div class="cnpy-rvg-clip"><div data-morph-list></div></div></div>
    </div>
    <span class="cnpy-rv-verdict" aria-hidden="true"></span>
  </div></div></div><div class="cnpy-rv-row" data-morph-key="rv:adr:5"><div class="cnpy-rv-row-in"><div class="cnpy-titem cnpy-surface cnpy-card cnpy-hitbox" data-rv-card="adr:5" aria-current="true">
    <button aria-current="true" data-act="reviewSelect" data-arg="adr:5" class="cnpy-hit" aria-label="Use D1 for the search index"></button>
    <span class="cnpy-selbar"></span>
    <div class="cnpy-rv-card-in" style="position:relative">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
        <div style="flex:1 1 auto;font-size:14px;font-weight:600;letter-spacing:-0.005em;color:var(--fg);min-width:0">Use D1 for the search index</div>
        
      </div>
      <div style="font-size:12.5px;color:var(--fg-55);margin-top:5px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">Use D1&#39;s FTS5.</div>
      <div class="cnpy-rv-meta" style="display:flex;align-items:center;flex-wrap:nowrap;white-space:nowrap;overflow:hidden;gap:6px;margin-top:10px;height:20px;font-size:11.5px;line-height:20px;color:var(--fg-55);min-width:0">
        <span data-slot="author" data-mtip="@andres" style="flex:none;display:inline-flex;align-items:center"><button data-act="openPerson" data-arg="andres" class="cnpy-personav" title="Andres" aria-label="@andres (Andres) — person card" style="display:flex;flex:none;padding:0;border-radius:50%"><div class="cnpy-av" title="Andres" style="--c:var(--p-sky);position:relative;width:18px;height:18px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AN</div></button></span>
        <span data-slot="kind" style="flex:none">Decision</span><span style="color:var(--fg-40)">·</span>
        <span data-slot="where" data-mtip="ADR-005" style="flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;font-family:var(--label);font-size:11px">ADR-005</span><span style="color:var(--fg-40)">·</span>
        <span data-slot="time" style="flex:none;color:var(--fg-40)">5h ago</span>
      </div>
    </div>
    <span class="cnpy-rv-verdict" aria-hidden="true"></span>
  </div></div></div></div>
    </div>
    <div class="cnpy-scroll cnpy-rv-detail" data-morph-key="rv-detail:queue" style="flex:1.05 1 0;min-width:0;overflow-y:auto">
      <button data-act="reviewBack" class="cnpy-rv-back"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>All items</button>
      <div class="cnpy-rv-body" data-morph-key="rvd:adr:5" style="max-width:var(--frame-reader);padding:24px 32px 100px">
    <div class="cnpy-rv-head" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px">
      <div style="min-width:0">
        <h2 style="margin:0;font-size:22px;font-weight:600;letter-spacing:-0.02em">Use D1 for the search index</h2>
        <div style="display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-top:8px;font-size:12px;color:var(--fg-55)">
          <span>Decision</span>
          <span style="color:var(--fg-40)">·</span><span style="font-family:var(--label);font-size:11.5px;color:var(--fg-55)">ADR-005</span>
          <span style="color:var(--fg-40)">·</span><span style="display:inline-flex;align-items:center;gap:6px"><button data-act="openPerson" data-arg="andres" class="cnpy-personchip" title="Andres" style="display:inline-flex;align-items:center;gap:6px;min-width:0;max-width:calc(100% + 10px);text-align:left;padding:2px 8px 2px 2px;margin:-2px -8px -2px -2px;border-radius:7px"><div class="cnpy-av" title="Andres" style="--c:var(--p-sky);position:relative;width:18px;height:18px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AN</div><span style=""><span style="font-family:var(--sans);font-size:12px;font-weight:500;color:var(--p-sky)">@andres</span></span></button></span>
          <span style="color:var(--fg-40)">·</span><span style="color:var(--fg-40)">5h ago</span>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;flex:none;padding-top:2px">
        
        <button data-act="reviewReject" data-arg="adr:5" class="cnpy-rejectbtn" style="box-sizing:border-box;height:34px;display:inline-flex;align-items:center;border-radius:8px;font-size:12.5px;background:transparent;border:1px solid var(--border-strong);padding:0 14px;font-weight:500;color:var(--fg-70);transition:all .12s ease">Reject</button>
        <button data-act="reviewAccept" data-arg="adr:5" class="cnpy-accentbtn" style="box-sizing:border-box;height:34px;display:inline-flex;align-items:center;border-radius:8px;font-size:12.5px;background:var(--accent);color:var(--accent-fg);border:1px solid var(--accent);padding:0 17px;font-weight:600">Ratify</button>
      </div>
    </div>
    
    <div style="display:flex;align-items:center;gap:10px;margin:22px 0 10px">
    <div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40)">PROPOSED RECORD</div>
    <div style="font-size:11.5px;color:var(--fg-40)">new document — no prior version</div>
  </div>
  <div class="cnpy-surface" style="padding:24px 28px 26px"><div style="margin-bottom:18px">
      <div style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--fg-55);margin-bottom:6px">Context</div>
      <div style="font-size:14.5px;line-height:1.7;color:var(--fg-70)">Search needs an index.</div>
    </div><div style="margin-bottom:18px">
      <div style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--fg-55);margin-bottom:6px">Decision</div>
      <div style="font-size:14.5px;line-height:1.7;color:var(--fg-70)">Use D1&#39;s FTS5.</div>
    </div><div style="margin-bottom:18px">
      <div style="font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--fg-55);margin-bottom:6px">Rationale</div>
      <div style="font-size:14.5px;line-height:1.7;color:var(--fg-70)">One store.</div>
    </div></div>
  </div>
    </div>
  </div></div>
    </main>
    <div class="cnpy-scrim" data-act="closeDrawer" aria-hidden="true"></div>
  </div>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
  </div>"
`;

exports[`field absent — each screen renders exactly what it did before Phase C > Unplaced (no row carries \`ai\`) 1`] = `
"<div data-cnpy-theme="light" data-screen="review" data-collapsed="0" data-narrow="0" data-phone="0" data-drawer="0" data-author="all" style="background:var(--bg);color:var(--fg);min-height:calc(100 * var(--vh));font-family:'Geist','Geist Fallback',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased">

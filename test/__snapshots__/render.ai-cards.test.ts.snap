    </div>
      <div class="cnpy-navrow n-prompts" data-tip="Prompt Library">
      <button data-act="goPrompts" class="cnpy-nav-i" aria-label="Prompt Library"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1"></path><path d="M16 21h1a2 2 0 0 0 2-2v-5a2 2 0 0 1 2-2 2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"></path></svg><span class="cnpy-lbl cnpy-nav-t">Prompt Library</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-sec"><span class="cnpy-lbl">Triage</span></div>
      <div class="cnpy-navrow n-review" data-tip="Review">

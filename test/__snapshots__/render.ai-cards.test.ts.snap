    </div>
      <div class="cnpy-navrow n-releases" data-tip="What&#39;s new">
      <button data-act="goReleases" class="cnpy-nav-i" aria-label="What&#39;s new"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path><path d="M19 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"></path></svg><span class="cnpy-lbl cnpy-nav-t">What&#39;s new</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
    </nav>
    <div class="cnpy-collapse" data-tip="Expand sidebar">
      <button data-act="toggleCollapse" class="cnpy-nav-i" aria-label="Collapse sidebar" aria-expanded="true"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path><path d="M14.5 9.5 12 12l2.5 2.5"></path></svg><span class="cnpy-lbl cnpy-nav-t">Collapse</span></button>
    </div>
    <div class="cnpy-ghost cnpy-lbl">agents produce · humans confirm</div>
    <div class="cnpy-foot" data-tip="Settings">
      <button data-act="goSettings" aria-label="Settings" class="cnpy-chip">
        <div class="cnpy-av" title="Alice" style="--c:var(--p-moss);position:relative;width:28px;height:28px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:10px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AL</div>
        <div class="cnpy-lbl cnpy-chip-t"><div class="cnpy-chip-n">alice</div><div class="cnpy-chip-h"><span style="font-family:var(--sans);font-size:11px;font-weight:500;color:var(--p-moss)">@alice</span></div></div>
        <svg class="cnpy-lbl" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" style="flex:none" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </button>
    </div>
    <div class="cnpy-tip" role="tooltip" data-keep></div>
  </aside>
    <main data-morph="review" style="flex:1;display:flex;flex-direction:column;min-width:0;background:var(--bg)">
      <header class="cnpy-hdr" style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 24px;min-height:57px;border-bottom:1px solid var(--border);flex:none">
    <div class="cnpy-hdr-l" style="display:flex;align-items:center;gap:12px;min-width:0">
      <button data-act="openDrawer" class="cnpy-menubtn cnpy-iconbtn" aria-label="Open navigation" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button><h1 style="font-size:15px;font-weight:600;letter-spacing:-0.01em;margin:0">Review</h1>
      
    </div>
    <div class="cnpy-hdr-r" style="display:flex;align-items:center;gap:8px;flex:none">
      <div class="cnpy-seg cnpy-seg--md" data-seg="triage-view" data-morph-key="seg:triage-view" role="group" aria-label="Review"><span class="cnpy-seg-ind" aria-hidden="true" data-keep></span><button type="button" tabindex="-1" data-field="seg:triage-view:queue" class="cnpy-seg-btn" data-act="setReviewView" data-arg="queue" aria-pressed="false">To review</button><button type="button" tabindex="0" data-field="seg:triage-view:unplaced" class="cnpy-seg-btn is-on" aria-pressed="true">Unplaced<span class="cnpy-seg-n">2</span></button></div><div data-sync-slot="ctl" class="sync-slot"></div><button data-act="supportOpen" data-arg="bug" data-support-trigger="bug" title="Report a bug" aria-label="Report a bug" aria-haspopup="dialog" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="7" width="8" height="12" rx="4"></rect><path d="M12 12v7"></path><path d="M9.5 7.5a2.5 2.5 0 0 1 5 0"></path><path d="M4 13h4M16 13h4M5 7l3.2 2.6M19 7l-3.2 2.6M5 20l3.2-2.8M19 20l-3.2-2.8"></path></svg>
    </button><button data-act="cycleTheme" title="Toggle theme" class="cnpy-iconbtn" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--border);display:grid;place-items:center;color:var(--fg-55)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path></svg>
    </button>
    </div>
  </header>
      <div id="cnpy-main" tabindex="-1" class="cnpy-scroll" style="flex:1;overflow-y:auto;min-height:0"><div class="cnpy-rv cnpy-up-screen" data-screen-label="Unplaced" data-view="unplaced" data-pane="list" style="display:flex;height:100%;min-width:0">
    <div class="cnpy-rv-list" data-morph-key="rv-list:unplaced" style="flex:.95 1 0;min-width:420px;border-right:1px solid var(--border);display:flex;flex-direction:column;min-height:0">
      <div class="cnpy-rv-lhead" style="padding:16px 20px 0">
        <div style="font-size:12.5px;color:var(--fg-55);margin-bottom:12px">Things an agent produced but couldn&#39;t place. Place each where it belongs, or discard it.</div>
      </div>
      <div class="cnpy-scroll cnpy-stagger cnpy-rv-rows" data-morph-list style="flex:1;overflow-y:auto;padding:2px 14px 80px"><div class="cnpy-rv-row cnpy-up-row" data-morph-key="up:7"><div class="cnpy-rv-row-in"><div class="cnpy-titem cnpy-surface cnpy-card cnpy-hitbox" data-up-card="7" aria-current="true">
    <button aria-current="true" data-act="maintSelect" data-arg="7" class="cnpy-hit" aria-label="Deploy checklist"></button>
    <span class="cnpy-selbar"></span>
    <div class="cnpy-rv-card-in" style="position:relative">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
        <div style="flex:1 1 auto;font-size:14px;font-weight:600;letter-spacing:-0.005em;color:var(--fg);min-width:0;overflow-wrap:anywhere">Deploy checklist</div>
        
      </div>
      <div style="font-size:12.5px;color:var(--fg-55);margin-top:5px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere">Before a deploy, run the migrations, then check the health endpoint.</div>
      <div class="cnpy-rv-meta" style="display:flex;align-items:center;flex-wrap:nowrap;white-space:nowrap;overflow:hidden;gap:6px;margin-top:10px;height:20px;font-size:11.5px;line-height:20px;color:var(--fg-55);min-width:0">
        <span data-slot="author" data-mtip="@andres" style="flex:none;display:inline-flex;align-items:center"><button data-act="openPerson" data-arg="andres" class="cnpy-personav" title="Andres" aria-label="Andres — person card" style="display:flex;flex:none;padding:0;border-radius:50%"><div class="cnpy-av" title="Andres" style="--c:var(--p-sky);position:relative;width:18px;height:18px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AN</div></button></span>
        <span data-slot="kind" style="flex:none">Doc proposal</span><span style="color:var(--fg-40)">·</span>
        <span data-slot="why" data-mtip="section &#39;runbooks&#39; is not in the vocabulary" style="flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis">Agent wasn&#39;t sure</span><span style="color:var(--fg-40)">·</span>
        <span data-slot="time" style="flex:none;color:var(--fg-40)">3h ago</span>
      </div>
    </div>
    <span class="cnpy-rv-verdict" aria-hidden="true"></span>
  </div></div></div><div class="cnpy-rv-row cnpy-up-row" data-morph-key="up:8"><div class="cnpy-rv-row-in"><div class="cnpy-titem cnpy-surface cnpy-card cnpy-hitbox" data-up-card="8">
    <button data-act="maintSelect" data-arg="8" class="cnpy-hit" aria-label="a free-form note"></button>
    <span class="cnpy-selbar"></span>
    <div class="cnpy-rv-card-in" style="position:relative">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
        <div style="flex:1 1 auto;font-size:14px;font-weight:600;letter-spacing:-0.005em;color:var(--fg);min-width:0;overflow-wrap:anywhere">a free-form note</div>
        
      </div>
      
      <div class="cnpy-rv-meta" style="display:flex;align-items:center;flex-wrap:nowrap;white-space:nowrap;overflow:hidden;gap:6px;margin-top:10px;height:20px;font-size:11.5px;line-height:20px;color:var(--fg-55);min-width:0">
        <span data-slot="author" data-mtip="@andres" style="flex:none;display:inline-flex;align-items:center"><button data-act="openPerson" data-arg="andres" class="cnpy-personav" title="Andres" aria-label="Andres — person card" style="display:flex;flex:none;padding:0;border-radius:50%"><div class="cnpy-av" title="Andres" style="--c:var(--p-sky);position:relative;width:18px;height:18px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AN</div></button></span>
        <span data-slot="kind" style="flex:none">Note</span><span style="color:var(--fg-40)">·</span>
        <span data-slot="why" data-mtip="Flagged by an agent" style="flex:0 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis">Agent wasn&#39;t sure</span><span style="color:var(--fg-40)">·</span>
        <span data-slot="time" style="flex:none;color:var(--fg-40)">3h ago</span>
      </div>
    </div>
    <span class="cnpy-rv-verdict" aria-hidden="true"></span>
  </div></div></div></div>
    </div>
    <div class="cnpy-scroll cnpy-rv-detail" data-morph-key="rv-detail:unplaced" style="flex:1.05 1 0;min-width:0;overflow-y:auto">
      <button data-act="maintBack" class="cnpy-rv-back"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>All items</button>
      <div class="cnpy-rvp cnpy-rvp--bg cnpy-up">
    <div class="cnpy-rv-body cnpy-rvp-body" data-morph-key="upd:7">
      <div class="cnpy-rvp-crumb">1 of 2 unplaced</div>
      <h2 class="cnpy-rvp-h">Deploy checklist</h2>
      <div class="cnpy-rvp-kind">
        <span>Doc proposal</span><span style="color:var(--fg-40)">·</span>
        <span style="display:inline-flex;align-items:center;min-width:0"><button data-act="openPerson" data-arg="andres" class="cnpy-personchip" title="Andres" style="display:inline-flex;align-items:center;gap:6px;min-width:0;max-width:calc(100% + 10px);text-align:left;padding:2px 8px 2px 2px;margin:-2px -8px -2px -2px;border-radius:7px"><div class="cnpy-av" title="Andres" style="--c:var(--p-sky);position:relative;width:18px;height:18px;border-radius:50%;background:var(--c);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--c) 45%,transparent);display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--p-ink);flex:none;overflow:hidden">AN</div><span style="min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:12.5px">Andres</span></button></span><span style="color:var(--fg-40)">·</span>
        <span style="font-size:12.5px;color:var(--fg-40)">3h ago</span>
        
      </div>
      <div class="cnpy-surface cnpy-up-why" style="padding:12px 15px;margin-top:18px">
        <div style="font-size:12px;font-weight:600;color:var(--fg-70)">Why it wasn't placed</div>
        <div style="font-size:12.5px;line-height:1.55;color:var(--fg-55);margin-top:4px;overflow-wrap:anywhere">section &#39;runbooks&#39; is not in the vocabulary</div>
      </div>
      
      <div class="cnpy-up-cardlabel" style="display:flex;align-items:center;gap:10px;margin:22px 0 10px">
      <div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40)">What the agent sent</div>
    </div>
      <div class="cnpy-surface cnpy-up-item" style="padding:24px 28px 26px"><div class="cnpy-md cnpy-rvp-md"><div class="mock-live-md">Before a deploy, run the migrations, then check the health endpoint.</div></div></div>
      <div class="cnpy-up-cardlabel" style="display:flex;align-items:center;gap:10px;margin:22px 0 10px">
      <div style="font-family:var(--label);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-40)">Place it as</div>
    </div><div class="cnpy-surface cnpy-up-place" style="padding:24px 28px 26px" data-item="7">
    <div class="cnpy-seg cnpy-seg--sm" data-seg="up-kind" data-morph-key="seg:up-kind" role="group" aria-label="Place it as"><span class="cnpy-seg-ind" aria-hidden="true" data-keep></span><button type="button" tabindex="0" data-field="seg:up-kind:doc" class="cnpy-seg-btn is-on" data-act="maintAssignKind" data-arg="doc" aria-pressed="true">Doc</button><button type="button" tabindex="-1" data-field="seg:up-kind:adr" class="cnpy-seg-btn" data-act="maintAssignKind" data-arg="adr" aria-pressed="false">Decision</button><button type="button" tabindex="-1" data-field="seg:up-kind:feed" class="cnpy-seg-btn" data-act="maintAssignKind" data-arg="feed" aria-pressed="false">Feed entry</button></div>
    <div class="cnpy-up-field"><div class="cnpy-up-label" id="up-section-l">Section</div><div class="cnpy-seg cnpy-seg--sm" data-seg="up-section" data-morph-key="seg:up-section" role="group" aria-label="Section"><span class="cnpy-seg-ind" aria-hidden="true" data-keep></span><button type="button" tabindex="0" data-field="seg:up-section:reference" class="cnpy-seg-btn" data-act="maintAssignSection" data-arg="reference" aria-pressed="false">Reference</button><button type="button" tabindex="-1" data-field="seg:up-section:context" class="cnpy-seg-btn" data-act="maintAssignSection" data-arg="context" aria-pressed="false">Context</button><button type="button" tabindex="-1" data-field="seg:up-section:decisions" class="cnpy-seg-btn" data-act="maintAssignSection" data-arg="decisions" aria-pressed="false">Decisions</button></div></div>
      <div class="cnpy-up-field"><div class="cnpy-up-label" id="up-space-l">Space</div><span style="font-size:12.5px;color:var(--fg-55)">No live space: a person creates or restores one in the Library.</span></div>
  </div>
    </div>
    <div class="cnpy-rvp-foot" data-morph-key="upf:7">
      <span class="cnpy-rvp-note">Pick a section</span>
      <button type="button" data-act="maintDiscard" data-arg="7" class="cnpy-rejectbtn cnpy-rvp-btn" style="border-radius:8px;border:1px solid var(--border-strong);color:var(--fg-70);background:transparent">Discard</button>
      <button type="button" disabled class="cnpy-rvp-btn cnpy-up-place-btn" style="border-radius:8px;padding:0 14px;font-weight:600;background:transparent;color:var(--fg-40);border:1px solid var(--border)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>Place</button>
    </div>
  </div>
    </div>
  </div></div>
    </main>
    <div class="cnpy-scrim" data-act="closeDrawer" aria-hidden="true"></div>
  </div>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
  </div>"
`;

exports[`field absent — each screen renders exactly what it did before Phase C > ticket detail (no \`ai\`) 1`] = `
"<div data-cnpy-theme="light" data-screen="ticketdetail" data-collapsed="0" data-narrow="0" data-phone="0" data-drawer="0" data-author="all" style="background:var(--bg);color:var(--fg);min-height:calc(100 * var(--vh));font-family:'Geist','Geist Fallback',system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased">
    <div class="cnpy-shell" style="display:flex;height:calc(100 * var(--vh));overflow:hidden">
    <a href="#cnpy-main" class="site-skip" data-skip="cnpy-main" style="border-radius:8px">Skip to content</a>
    <aside class="cnpy-aside" data-screen-label="Sidebar">
    <div class="cnpy-logo">
      <button data-act="goSite" aria-label="About Trov" data-tip="About Trov" class="cnpy-logo-b"><svg width="24" height="24" viewBox="0 0 100 100" aria-hidden="true" style="flex:none"><path fill="var(--mark,#616ACB)" d="M0 83.72H46.51V46.51H0ZM46.51 46.51H83.72V0H46.51ZM83.72 46.51V83.72H46.51V100H100V46.51Z"></path></svg><span class="cnpy-lbl cnpy-logo-t">Trov</span></button>
    </div>
    <div class="cnpy-orgslot"><div class="cnpy-orgsw" data-tip="SaplingLearn: switch organization">
    <button type="button" data-act="orgsMenu" data-field="orgsMenu" data-orgsw-trigger class="cnpy-orgsw-b" style="border-radius:8px" aria-haspopup="dialog" aria-expanded="false" aria-controls="orgs-menu" aria-label="SaplingLearn: switch organization">
      <span class="cnpy-orgtile" aria-hidden="true" style="position:relative;overflow:hidden;width:24px;height:24px;font-size:12px;border-radius:7px">S</span>
      <span class="cnpy-lbl cnpy-orgsw-n">SaplingLearn</span>
      <span class="cnpy-lbl cnpy-badge" data-n="0" title="Nothing waiting">0</span><span class="cnpy-dot" data-n="0"></span>
      <svg class="cnpy-lbl" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;color:var(--fg-40)"><path d="m7 9 5-5 5 5"></path><path d="m7 15 5 5 5-5"></path></svg>
    </button>
  </div></div>
    <nav class="cnpy-navlist" aria-label="Primary">
      <div class="cnpy-searchwrap" data-tip="Search">
        <div data-act="sideSearchFocus" class="cnpy-search">
          <svg class="cnpy-nav-ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
          <input data-act="sideSearch" data-field="sideSearch" class="cnpy-lbl cnpy-search-in" placeholder="Search Trov" aria-label="Search Trov" autocomplete="off" spellcheck="false" tabindex="0" />
          <kbd class="cnpy-lbl cnpy-kbd">Ctrl K</kbd>
        </div>
      </div>
      <div class="cnpy-sec is-first"><span class="cnpy-lbl">Workspace</span></div>
      <div class="cnpy-navrow n-home" data-tip="Home">
      <button data-act="goHome" class="cnpy-nav-i" aria-label="Home"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9v10a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9"></path></svg><span class="cnpy-lbl cnpy-nav-t">Home</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>
    </div>
      <div class="cnpy-navrow n-mywork" data-tip="My Work">
      <button data-act="goMyWork" class="cnpy-nav-i" aria-label="My Work"><svg class="cnpy-nav-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path><path d="M3 12.5h18"></path></svg><span class="cnpy-lbl cnpy-nav-t">My Work</span><span class="cnpy-lbl cnpy-badge" data-n="0">0</span><span class="cnpy-dot" data-n="0"></span></button>

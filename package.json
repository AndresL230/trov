{
  "name": "trov",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "npm run build:web && node scripts/dev/ensure-seeded.mjs && (npm run watch:web & wrangler dev)",
    "dev:seeded": "npm run build:web && node scripts/dev/ensure-seeded.mjs --force && (npm run watch:web & wrangler dev)",
    "dev:as": "node scripts/dev/as.mjs",
    "watch:web": "vite build --config web/vite.config.ts --watch --emptyOutDir false",
    "deploy": "npm run build:web && wrangler deploy",
    "deploy:preview": "wrangler d1 migrations apply trov-preview --remote --env preview && wrangler preview",
    "pretest": "mkdir -p web/dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json",
    "check": "npm run typecheck && npm run build:web",
    "db:create": "wrangler d1 create trov",
    "db:migrate:local": "wrangler d1 migrations apply trov --local",
    "db:migrate:remote": "wrangler d1 migrations apply trov --remote",
    "seed": "node scripts/seed-dev.mjs",
    "ask:gallery": "esbuild scripts/ask-gallery/build.ts --bundle --platform=node --format=esm --packages=external --outfile=.ask-gallery/build.mjs --log-level=warning && node .ask-gallery/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.16.2",
    "dompurify": "^3.4.11",
    "hono": "^4.12.0",
    "marked": "^18.0.5",
    "mermaid": "11.17.2",
    "pdfjs-dist": "6.4.299",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^26.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.84.0"
  }
}

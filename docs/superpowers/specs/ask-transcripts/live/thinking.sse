data: {"id":2,"groupId":"3-1-1","tool":"create_ticket","kind":"ticket","preview":{"title":"New ticket","lines":[{"label":"Title","value":"Update netlify-connect.test.ts for the new status markup"},{"label":"Description","value":"Follow-up to #1 (Netlify connect test fails on main).\n\nnetlify-connect.test.ts still asserts on the old pill markup, which the status-marks PR removed, so the test fails on main.\n\n**To do**\n- Rewrite the assertions to target the current status-mark markup instead of the removed …"},{"label":"Category","value":"bug"},{"label":"Priority","value":"high"},{"label":"Assignee","value":"Unassigned"},{"label":"Sprint","value":"Backlog"}],"item":null},"fields":{"title":"Update netlify-connect.test.ts for the new status markup","body":"Follow-up to #1 (Netlify connect test fails on main).\n\nnetlify-connect.test.ts still asserts on the old pill markup, which the status-marks PR removed, so the test fails on main.\n\n**To do**\n- Rewrite the assertions to target the current status-mark markup instead of the removed pill.\n- Prefer asserting on roles, labels or test ids over class names and markup structure, so a future visual change doesn't break the test again.\n- Confirm the test passes on main, then resolve #1.","category":"bug","priority":"high","assignee":null,"sprint_id":null},"editable":["title","category","priority","assignee"],"note":null,"state":"proposed"}


node_modules/
# a worktree's node_modules is often a SYMLINK to the main checkout's — `node_modules/` (a directory) never matches it
node_modules
web/dist/
.wrangler/
.dev.vars
*.log
.superpowers/
.trov/
.canopy/
# npm run ask:gallery — the built Ask Trov gallery and its bundled builder (scripts/ask-gallery/)
.ask-gallery/

# multitenancy migration checks: local production exports (scripts/mt/verify-migration.mjs) — never commit
.mt/

# copy-data.sh: the read-only pointer at Canopy and its production dump — never commit
wrangler.old.toml
*-dump.sql
*-dump.counts.json

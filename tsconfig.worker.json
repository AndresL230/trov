{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"]
  },
  "include": ["src", "shared", "test", "vitest.config.ts"],
  // Tests that import web/src code (render + triage-map mapping tests) are type-checked
  // under tsconfig.web.json (DOM lib) — never with worker fetch types. Vitest still runs
  // them in the pool-workers harness at runtime (file discovery ignores tsconfig).
  "exclude": ["test/render.plans.test.ts", "test/render.support.test.ts", "test/render.pricing.test.ts", "test/render.landing.test.ts", "test/render.legal.test.ts", "test/render.site-feature.test.ts", "test/render.quicksearch.test.ts", "test/render.platform.test.ts", "test/mentions.test.ts", "test/render.tickets.test.ts", "test/render.sprints.test.ts", "test/hash.test.ts", "test/render.review.test.ts", "test/render.review-rendered.test.ts", "test/render.mywork.test.ts", "test/render.roadmap.test.ts", "test/render.timeline.test.ts", "test/render.docs.test.ts", "test/triage-map.test.ts", "test/render.notifications.test.ts", "test/render.onboard.test.ts", "test/render.people.test.ts", "test/render.people-links.test.ts", "test/render.feed.test.ts", "test/render.scroll.test.ts", "test/render.sidebar.test.ts", "test/render.phone.test.ts", "test/render.repo.test.ts", "test/issue-ref.test.ts", "test/render.corners.test.ts", "test/render.connect.test.ts", "test/render.handoffs.test.ts", "test/render.artifacts.test.ts", "test/favicon.test.ts", "test/render.surface.test.ts", "test/releases.test.ts", "test/render.tabs.test.ts", "test/render.org-settings.test.ts", "test/render.orgs.test.ts", "test/api.prefix.test.ts", "test/tabs.instant.test.ts", "test/render.dropdown.test.ts", "test/render.org-logo.test.ts", "test/render.github-app.test.ts", "test/render.billing.test.ts", "test/render.sync.test.ts", "test/render.skeleton.test.ts", "test/render.empty.test.ts", "test/render.welcome.test.ts", "test/render.settings-plan.test.ts", "test/render.gifts.test.ts", "test/render.site-mobile.test.ts"]
}
